# Jarvis environment configuration.
# Copy to `.env` and edit. All values are optional; local-first defaults apply.

# --- Server ---
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8771

# --- Local data/config locations (default: ./data and ./config) ---
# JARVIS_DATA_DIR=/absolute/path/to/data
# JARVIS_CONFIG_DIR=/absolute/path/to/config

# --- Providers (order matters; comma-separated) ---
JARVIS_PROVIDERS=groq,gemini,openrouter,ollama

# API keys (only the providers you use)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_API_KEY=

# Provider models (optional overrides)
# JARVIS_GROQ_MODEL=openai/gpt-oss-120b
# JARVIS_GEMINI_MODEL=gemini-2.0-flash
# JARVIS_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# JARVIS_OLLAMA_MODEL=llama3.2:1b

# --- Atif Assistant bridge ---
# JARVIS_ATIF_URL=http://127.0.0.1:8770
